{
  "name": "resume-reject-video",
  "version": "3.3.0",
  "description": "Premium senior-agent orchestration skill: voice script → HyperFrames HTML with anchor-grid layout, kinetic typography, SVG animations, glassmorphism evidence cards, complete sound system (SFX synthesis + cue sheet + audio mixing), and design-contract validation.",
  "author": "Arena Agent",
  "entrypoint": "generate.py",
  "runtime": "python3",
  "pipeline": [
    "parse_script",
    "detect_topic",
    "decompose_anchor_grid_scenes",
    "generate_scene_compositions",
    "prepare_validation_gate",
    "build_index_root_html",
    "hyperframes_lint",
    "hyperframes_render",
    "gen_sfx",
    "mix_audio",
    "ffmpeg_mux"
  ],
  "inputs": {
    "script": {
      "type": "string",
      "description": "Path to a .txt voice script. Plain lines (auto-timed ~145 wpm) or [start-end] Text segments. Use **word** for emphasis.",
      "required": true
    },
    "topic": {
      "type": "string",
      "description": "Force a topic (e.g. 'Tor', 'VPN', 'AI') to trigger animation + evidence. Auto-detected if omitted.",
      "required": false,
      "default": null
    },
    "voiceover": {
      "type": "string",
      "description": "Path to voiceover audio file (assets/audio/voice.mp3).",
      "required": false,
      "default": null
    },
    "music": {
      "type": "string",
      "description": "Path to background music file (assets/audio/music.mp3).",
      "required": false,
      "default": null
    },
    "output": {
      "type": "string",
      "description": "Output HTML path.",
      "default": "index.html",
      "required": false
    },
    "wpm": {
      "type": "integer",
      "description": "Words per minute for auto-timing (premium default: 145).",
      "default": 145,
      "required": false
    },
    "no_end_screen": {
      "type": "boolean",
      "description": "Skip the premium end screen.",
      "default": false,
      "required": false
    }
  },
  "outputs": {
    "html": {
      "type": "file",
      "description": "Premium HyperFrames index.html composition"
    },
    "scene_files": {
      "type": "array",
      "description": "Generated compositions/sN-*.html files"
    },
    "report": {
      "type": "object",
      "description": "Build report with scene count, duration, animations, evidence, transitions, audio cues, warnings, search queries"
    }
  },
  "anchor_grid": {
    "anchors": ["kicker", "hero", "body", "chip", "presenter"],
    "layout": "bottom-fixed, only top half re-composes",
    "frame_zero": "poster (data-cover=1)",
    "motion": "transform-only, lands in first half of beat",
    "fields": ["accent", "ground", "ink", "secondary", "tertiary", "quaternary"],
    "field_rule": "no two neighbor scenes share a field"
  },
  "sound_system": {
    "sfx_synthesis": "scripts/gen_sfx.py (14 SFX from scratch, no licensing)",
    "cue_sheet": "assets/sfx/cues.json (section-relative offsets)",
    "audio_mixer": "scripts/mix_audio.py (VO + cues + bed → master.wav)",
    "loudness_target": "-14 LUFS",
    "true_peak_max": "-1 dBTP",
    "bed_level": "0.15 (≈ -29 LUFS, ≈13 LU under VO)",
    "ducking": "none (level gap is the duck)",
    "max_cues_per_second": 1.0
  },
  "scene_types": ["hook", "body_left", "body_right", "animation", "evidence", "cta", "end_screen", "transition"],
  "archetypes": ["card-led", "stat-led", "type-led"],
  "media_platforms": ["youtube", "instagram", "forum", "website", "image"],
  "commands": {
    "generate": "python3 generate.py --script <script> [--topic <topic>] [--voiceover <file>] [--music <file>]",
    "validate": "python3 scripts/prepare.py",
    "lint": "npx hyperframes lint",
    "preview": "npx hyperframes preview",
    "render": "npx hyperframes render",
    "gen_sfx": "python3 scripts/gen_sfx.py",
    "mix_audio": "python3 scripts/mix_audio.py",
    "mux": "ffmpeg -i rendered.mp4 -i renders/master.wav -c:v copy -c:a aac -shortest final.mp4"
  },
  "technical_topics": [
    "tor", "onion", "anonymous browsing", "dark web", "vpn", "proxy",
    "isp", "relay", "network", "packet", "encryption", "cybersecurity",
    "dns", "cdn", "blockchain", "bitcoin", "ai", "machine learning",
    "how internet works", "neural network", "large language model"
  ],
  "example_input": ["example_script.txt", "example_technical.txt"],
  "example_output": ["output_simple.html", "output_technical.html"],
  "agent_workflow": [
    "1. Receive voice script + optional topic + optional audio files",
    "2. Run generate.py (creates scene compositions + index.html)",
    "3. Run prepare.py (validation gate)",
    "4. Run npx hyperframes lint (0 errors gate)",
    "5. Read printed search queries + yt-dlp commands for media sourcing",
    "6. (Optional) Source/download media, fill data-var-src URLs",
    "7. Run gen_sfx.py (synthesize SFX)",
    "8. Run mix_audio.py (VO + cues + bed → master.wav)",
    "9. ffmpeg mux → final.mp4",
    "10. Return index.html + render commands to user"
  ]
}
