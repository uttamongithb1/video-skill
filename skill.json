{
  "name": "resume-reject-video",
  "version": "3.0.0",
  "description": "Premium senior-agent orchestration skill: voice script → HyperFrames HTML with kinetic typography, glassmorphism, SVG animations, audio sync cues, and media sourcing for YouTube/Instagram/forums/websites.",
  "author": "Arena Agent",
  "entrypoint": "generate.py",
  "runtime": "python3",
  "pipeline": [
    "parse_script",
    "detect_topic",
    "decompose_premium_scenes",
    "insert_transitions",
    "generate_kinetic_typography",
    "assemble_html",
    "validate_design_contract"
  ],
  "inputs": {
    "script": {
      "type": "string",
      "description": "Path to a .txt voice script. Plain lines (auto-timed ~145 wpm) or [start-end] Text segments. Use **word** for emphasis (right-aligned brand anchor with pop animation).",
      "required": true
    },
    "topic": {
      "type": "string",
      "description": "Force a topic (e.g. 'Tor', 'VPN', 'AI') to trigger premium animation + evidence. Auto-detected if omitted.",
      "required": false,
      "default": null
    },
    "voiceover": {
      "type": "string",
      "description": "Path to voiceover audio file (assets/audio/voice.mp3).",
      "required": false,
      "default": null
    },
    "music": {
      "type": "string",
      "description": "Path to background music file (assets/audio/music.mp3).",
      "required": false,
      "default": null
    },
    "output": {
      "type": "string",
      "description": "Output HTML path.",
      "default": "index.html",
      "required": false
    },
    "wpm": {
      "type": "integer",
      "description": "Words per minute for auto-timing (premium default: 145).",
      "default": 145,
      "required": false
    },
    "no_end_screen": {
      "type": "boolean",
      "description": "Skip the premium end screen.",
      "default": false,
      "required": false
    }
  },
  "outputs": {
    "html": {
      "type": "file",
      "description": "Premium HyperFrames index.html composition ready for npx hyperframes preview / render"
    },
    "report": {
      "type": "object",
      "description": "Build report with scene count, duration, animations, evidence, transitions, kinetic scenes, audio cues, warnings, search queries, media download commands"
    }
  },
  "styling": {
    "resolution": "1280x720",
    "fps": 30,
    "palette": {
      "dark_bg": "#6C0013",
      "dark_text": "#FFF8F0",
      "light_bg": "#EBE6F0",
      "light_text": "#0F0C14",
      "accent": "#FFD700",
      "glass": "rgba(255,255,255,0.65)",
      "shadow_hard": "0 20px 60px rgba(108,0,19,0.25)"
    },
    "typography": {
      "hook": "80px / weight 950",
      "section": "64px / weight 900",
      "body": "44px / weight 750",
      "caption": "26px / weight 600",
      "cta": "56px / weight 900"
    },
    "motion": {
      "ease_premium": "cubic-bezier(0.23, 1, 0.32, 1)",
      "ease_bounce": "cubic-bezier(0.68, -0.55, 0.27, 1.55)",
      "pop_in": "0.45s",
      "slide_in": "0.7s",
      "ken_burns": "8s",
      "stagger": "0.12s"
    },
    "alignment": {
      "hook": "center, top band, kinetic pop",
      "body_left": "left, slide-in from left",
      "body_right": "right, slide-in from right, brand color",
      "emphasis": "right, pop + scale, weight 950",
      "cta": "center, bottom, scale reveal",
      "animation": "center, SVG + Ken Burns",
      "evidence": "left, glass card, lower third",
      "transition": "motion-blur wipe"
    }
  },
  "technical_topics": [
    "tor", "onion", "anonymous browsing", "dark web", "vpn", "proxy",
    "isp", "relay", "network", "packet", "encryption", "cybersecurity",
    "dns", "cdn", "blockchain", "bitcoin", "ai", "machine learning",
    "how internet works", "neural network", "large language model"
  ],
  "media_platforms": ["youtube", "instagram", "forum", "website", "image"],
  "scene_types": [
    "hook", "section", "body_left", "body_right", "emphasis",
    "animation", "evidence", "lower_third", "cta", "end_screen", "transition"
  ],
  "commands": {
    "generate": "python3 generate.py --script <script> [--topic <topic>] [--voiceover <file>] [--music <file>] --output index.html",
    "preview": "npx hyperframes preview",
    "render": "npx hyperframes render",
    "download_media": "yt-dlp -f \"bestvideo[height<=1080]+bestaudio/best\" --merge-output-format mp4 \"ytsearch1:<query>\" -o \"assets/media/%(title)s.%(ext)s\""
  },
  "example_input": ["example_script.txt", "example_technical.txt"],
  "example_output": ["output_simple.html", "output_technical.html"],
  "agent_workflow": [
    "1. Receive voice script + optional topic + optional audio files",
    "2. Run generate.py",
    "3. Read printed search queries + yt-dlp download commands",
    "4. (Optional) Source/download media, fill data-var-src URLs in evidence cards",
    "5. Return index.html + npx hyperframes preview/render commands"
  ]
}
