<!--
  _scene-base.html.tmpl — anchor-grid scene skeleton.
  Invariant bottom half: kicker → hero → body → chip → presenter.
  Only the top half (body anchor 3) changes shape per archetype.
-->
<template>
  <style>
    /* @tokens:start — generated by scripts/prepare.py from PARAMS.json */
    :root { }
    /* @tokens:end */

    @font-face { font-family: "Anton"; src: url("../assets/fonts/Anton-Regular.ttf"); }
    @font-face { font-family: "Archivo Black"; src: url("../assets/fonts/ArchivoBlack-Regular.ttf"); }
    @font-face { font-family: "Space Mono"; src: url("../assets/fonts/SpaceMono-Regular.ttf"); font-weight: 400; }
    @font-face { font-family: "Space Mono"; src: url("../assets/fonts/SpaceMono-Bold.ttf"); font-weight: 700; }

    #root { position: absolute; inset: 0; overflow: hidden;
      font-family: var(--font-mono); -webkit-font-smoothing: antialiased; }

    /* Background field chosen by ONE attribute */
    #root[data-field="ground"]    { background: var(--ground);    color: var(--ink); }
    #root[data-field="accent"]    { background: var(--accent);    color: var(--on-accent); }
    #root[data-field="ink"]       { background: var(--ink);       color: var(--on-ink); }
    #root[data-field="secondary"]  { background: var(--secondary);  color: var(--ink); }
    #root[data-field="tertiary"]   { background: var(--tertiary);   color: var(--on-tertiary); }
    #root[data-field="quaternary"] { background: var(--quaternary); color: var(--on-quaternary); }

    .dots { position: absolute; inset: 0; opacity: var(--halftone); color: currentColor;
      background-image: radial-gradient(currentColor var(--dot-r),
        transparent calc(var(--dot-r) + .1px));
      background-size: var(--dot-pitch) var(--dot-pitch); }

    /* ANCHOR 1 · kicker */
    .kicker { position: absolute; left: var(--margin-x); top: var(--kicker-top);
      font-size: var(--size-kicker); font-weight: 700;
      letter-spacing: var(--tracking-label); text-transform: uppercase; opacity: 0; }
    .kicker i { display: inline-block; width: var(--dash-w); height: var(--dash-h);
      background: var(--accent); vertical-align: middle; margin-right: var(--dash-gap); }
    #root[data-field="accent"] .kicker i { background: var(--on-accent); }
    #root[data-field="tertiary"] .kicker i { background: var(--accent); }

    /* ANCHOR 2 · hero */
    .disp { font-family: var(--font-display); text-transform: uppercase;
      line-height: var(--lh-display); letter-spacing: -.01em; }
    #sX-hero { position: absolute; left: var(--margin-x); top: var(--hero-top);
      font-size: var(--size-hero); opacity: 0; max-width: 92%; }

    /* ANCHOR 3A · card (card-led) */
    <!-- #css:A -->
    #sX-card { position: absolute; left: var(--margin-x); top: var(--card-top);
      width: var(--card-w); min-height: calc(var(--card-h) * .80);
      max-height: var(--card-h); background: var(--paper);
      color: var(--paper-ink); border: var(--border-w) solid var(--ink);
      border-radius: var(--card-radius); overflow: hidden; opacity: 0;
      box-shadow: var(--hard-shadow) color-mix(in srgb, var(--ink) 16%, transparent); }
    #sX-card .bar { height: var(--bar-h); display: flex; align-items: center;
      gap: var(--bar-gap); padding: 0 var(--bar-pad);
      border-bottom: var(--border-w) solid var(--ink);
      background: var(--paper-bar); color: var(--paper-ink); }
    #sX-card .bar .f { font-size: var(--size-body); font-weight: 700; }
    #sX-card .bar .t { margin-left: auto; font-size: var(--size-body);
      letter-spacing: .1em; color: var(--paper-muted); }
    #sX-card .body { padding: var(--card-pad) var(--card-pad) 0; }
    #sX-card .row { display: flex; gap: calc(var(--bar-gap) * 1.3);
      padding: calc(var(--card-pad) * .3) 0; font-size: var(--size-body);
      line-height: 1.5; }
    #sX-card .row .ln { width: calc(var(--size-body) * 2); text-align: right;
      color: var(--paper-muted); flex: none; }
    <!-- /#css:A -->

    /* ANCHOR 3B · stat (stat-led) */
    <!-- #css:B -->
    #sX-odo { position: absolute; left: var(--margin-x); top: var(--card-top);
      display: flex; opacity: 0; }
    #sX-odo .col { font-size: 1em; width: calc(var(--size-hero) * .58);
      height: var(--size-hero); overflow: hidden; }
    #sX-odo .col .strip { display: block; }
    #sX-odo .col .strip span { display: block; height: 1em; line-height: 1em;
      text-align: center; font-family: var(--font-display);
      font-size: var(--size-hero); color: var(--accent); }
    #sX-odo { font-size: var(--size-hero); }
    #root[data-field="accent"] #sX-odo .col .strip span { color: var(--on-accent); }
    #sX-support { position: absolute; left: var(--margin-x);
      top: calc(var(--card-top) + var(--size-hero) * 1.08);
      font-size: var(--size-body); opacity: 0; max-width: 80%; line-height: 1.45; }
    <!-- /#css:B -->

    /* ANCHOR 3C · type-only (type-led) */
    <!-- #css:C -->
    #sX-lines { position: absolute; left: var(--margin-x); top: var(--card-top);
      font-family: var(--font-display);
      font-size: calc(var(--size-hero) * .54); line-height: 1.04;
      text-transform: uppercase; opacity: 0; max-width: 88%; }
    <!-- /#css:C -->

    /* ANCHOR 4 · chip — INVARIANT position */
    #sX-chip { position: absolute; left: var(--margin-x); top: var(--chip-top);
      height: var(--chip-h); display: flex; align-items: center;
      gap: calc(var(--bar-gap) * 1.4); padding: 0 var(--chip-pad);
      border-radius: var(--chip-radius); background: var(--ink);
      color: var(--on-ink); font-size: var(--size-chip); font-weight: 700;
      letter-spacing: .04em; text-transform: uppercase; opacity: 0; }
    #sX-chip b { width: calc(var(--chip-h) * .19); height: calc(var(--chip-h) * .19);
      border-radius: 50%; background: var(--accent); display: block; }
    #root[data-field="ink"] #sX-chip { background: var(--accent);
      color: var(--on-accent); }
    #root[data-field="ink"] #sX-chip b { background: var(--on-accent); }

    /* ANCHOR 5 · presenter — INVARIANT position, cropped by frame */
    #sX-char { position: absolute; left: var(--presenter-x);
      top: var(--presenter-top); width: calc(var(--w) - var(--presenter-x));
      height: var(--presenter-h); opacity: 0; }
    #sX-char img { width: 100%; height: 100%; object-fit: contain;
      object-position: bottom center; }
    #sX-glow { position: absolute; left: var(--presenter-x);
      top: var(--presenter-top); width: var(--glow); height: var(--glow);
      border-radius: 50%; opacity: 0;
      background: radial-gradient(circle,
        color-mix(in srgb, currentColor calc(var(--glow-alpha) * 100%),
        transparent) 0%, transparent 70%); }
    #root[data-field="ink"], #root[data-field="tertiary"] { --glow-alpha: 0.42; }
  </style>

  <script>window.__sceneTweens = window.__sceneTweens || [];</script>
  <div id="root" data-composition-id="sX" data-cover="0"
       data-field="ground" data-width="1080" data-height="1920">
    <div class="dots"></div>
    <div id="sX-glow"></div>

    <div class="kicker" id="sX-kicker"><i></i>SLOT:KICKER</div>
    <div class="disp" id="sX-hero">SLOT:HERO</div>

    <!-- #arch:A -->
    <div id="sX-card">
      <div class="bar"><span class="f">SLOT:CARD_TITLE</span>
        <span class="t">SLOT:CARD_META</span></div>
      <div class="body">SLOT:CARD_BODY</div>
    </div>
    <!-- /#arch:A -->

    <!-- #arch:B -->
    <div id="sX-odo">{{STRIP}}</div>
    <div id="sX-support">SLOT:SUPPORT</div>
    <!-- /#arch:B -->

    <!-- #arch:C -->
    <div id="sX-lines">SLOT:LINE1<br />SLOT:LINE2</div>
    <!-- /#arch:C -->

    <div id="sX-chip"><b></b>SLOT:CHIP</div>
    <div id="sX-char"><img src="SLOT:POSE" /></div>
  </div>

  <script>
    const tl = gsap.timeline({ paused: true });
    const cover = document.getElementById("root").dataset.cover === "1";
    const bodyAt = cover ? 0.05 : 0.45;
    if (cover) gsap.set(["#sX-kicker", "#sX-hero", "#sX-char", "#sX-glow"],
                        { opacity: 1, x: 0, y: 0, scale: 1 });

    tl.fromTo("#sX-kicker", { y: cover ? 0 : -26, opacity: cover ? 1 : 0 },
              { y: 0, opacity: 1, duration: cover ? .01 : .32, ease: "power3.out" }, .04);
    tl.fromTo("#sX-hero", { scale: cover ? 1 : 1.3, y: cover ? 0 : 44,
              opacity: cover ? 1 : 0 },
              { scale: 1, y: 0, opacity: 1, duration: cover ? .01 : .30,
              ease: "power4.out" }, .30);
    tl.fromTo("#sX-glow", { opacity: cover ? 1 : 0 },
              { opacity: 1, duration: cover ? .01 : .45, ease: "power2.out" }, .30);
    tl.fromTo("#sX-char", { y: cover ? 0 : 46, scale: cover ? 1 : .92,
              opacity: cover ? 1 : 0 },
              { y: 0, scale: 1, opacity: 1,
              duration: cover ? .01 : .34, ease: "power3.out" }, .34);

    /* #js:A */
    tl.fromTo("#sX-card", { y: 56, scale: .95, opacity: 0 },
              { y: 0, scale: 1, opacity: 1, duration: .32, ease: "power3.out" }, bodyAt);
    /* /#js:A */

    /* #js:B */
    tl.fromTo("#sX-odo", { y: 56, opacity: 0 },
              { y: 0, opacity: 1, duration: .32, ease: "power3.out" }, bodyAt);
    document.querySelectorAll("#sX-odo .col").forEach((col, i) => {
      tl.to(col.querySelector(".strip"),
            { y: `-=${+col.dataset.digit || 0}em`,
              duration: 0.95 - i * 0.05, ease: "power2.inOut" },
            0.55 + i * 0.05);
    });
    tl.fromTo("#sX-support", { y: 24, opacity: 0 },
              { y: 0, opacity: 1, duration: .3, ease: "power2.out" }, 1.25);
    /* /#js:B */

    /* #js:C */
    tl.fromTo("#sX-lines", { y: 44, opacity: 0 },
              { y: 0, opacity: 1, duration: .30, ease: "power4.out" }, bodyAt);
    /* /#js:C */

    tl.fromTo("#sX-chip", { y: 30, opacity: 0 },
              { y: 0, opacity: 1, duration: .26, ease: "power3.out" },
              cover ? 0.65 : 0.18);

    tl.to("#sX-hero", { y: -14, duration: .7, ease: "power1.inOut" }, 5.2);

    (window.__sceneTweens || []).forEach(function (fn) {
      try { fn(tl); } catch (e) { console.error(e); }
    });

    window.__timelines["sX"] = tl;
  </script>
</template>
